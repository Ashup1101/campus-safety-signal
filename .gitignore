# Markdown never enters git
*.md
*.MD

# Local-only context, data, secrets
.claude/
.notes/
data/
.env
.env.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Notebooks
.ipynb_checkpoints/

# Models
/models/
*.pt
*.pth
*.onnx
*.safetensors
*.gguf
*.joblib
*.pkl

# Terraform: local state and plans never leave this machine
.tools/
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/tfplan
infra/.build/

# OS / editors
.DS_Store
.vscode/
.idea/

# dbt artifacts (transform writes them under data/warehouse/, these catch manual runs)
dbt/target/
dbt/logs/
dbt/dbt_packages/
